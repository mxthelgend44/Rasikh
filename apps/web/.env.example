# Server-side only. Never expose this with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# demo: cached, deterministic agent responses (no network). live: OpenAI Responses API.
RASIKH_AI_MODE=demo

# Required only when RASIKH_AI_MODE=live. Server-side only; never prefix with NEXT_PUBLIC_.
OPENAI_MODEL=
# Rasikh Guard sidecar (INTEGRATION.md 7). The AI journey fails closed if it is unreachable.
RASIKH_GUARD_URL=http://localhost:8787
