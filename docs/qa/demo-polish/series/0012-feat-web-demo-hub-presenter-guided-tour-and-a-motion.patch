+          <p className="text-body text-fg-secondary">{copy.noSteps}</p>
+        )}
+
+        <div className="mt-4 border-t border-line pt-2">
+          <button
+            type="button"
+            onClick={() => setListOpen((open) => !open)}
+            aria-expanded={listOpen}
