From db1be82acd51bf001fc0a9f1d17a3c486b1b1a12 Mon Sep 17 00:00:00 2001
From: maalh <sometimes7799s@gmail.com>
Date: Fri, 2 Oct 2026 12:50:39 +0400
Subject: [PATCH 1/8] fix(employer): first hire and company take the
 INTEGRATION.md fixture ids

The add-hire and new-expansion forms always generated hire_<uuid> and company_<uuid>,
so a demo never produced hire_demo_001 or company_demo_001 and the Guard and TAMM
fixtures (doc_passport_hire_demo_001, lease_reem_2207 ...) could not line up.
The first one of each now uses the fixture id; later ones stay unique.
---
 apps/web/src/components/employer/expansion.tsx | 5 ++++-
 apps/web/src/components/employer/new-hire.tsx  | 7 ++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/apps/web/src/components/employer/expansion.tsx b/apps/web/src/components/employer/expansion.tsx
index 05c6f43..970d678 100644
--- a/apps/web/src/components/employer/expansion.tsx
+++ b/apps/web/src/components/employer/expansion.tsx
@@ -1,5 +1,6 @@
 'use client';
 
+import { DEMO_FIXTURES } from '@rasikh/shared';
 import Link from 'next/link';
 import { useState, type FormEvent } from 'react';
 import {
@@ -771,7 +772,9 @@ function CompanyDialog({
   const [kind, setKind] = useState<JurisdictionKind>('adgm');
   async function submit(event: FormEvent<HTMLFormElement>) {
     event.preventDefault();
-    const id = `company_${crypto.randomUUID()}`;
+    const id = Object.hasOwn(store.getSnapshot().state.companies, DEMO_FIXTURES.company)
+      ? `company_${crypto.randomUUID()}`
+      : DEMO_FIXTURES.company;
     const recommendation: SetupRecommendation = {
       generatedBy: 'demo',
       recommended: kind,
diff --git a/apps/web/src/components/employer/new-hire.tsx b/apps/web/src/components/employer/new-hire.tsx
index 6cde7df..1a490c9 100644
--- a/apps/web/src/components/employer/new-hire.tsx
+++ b/apps/web/src/components/employer/new-hire.tsx
@@ -1,5 +1,6 @@
 'use client';
 
+import { DEMO_FIXTURES } from '@rasikh/shared';
 import { useState, type FormEvent } from 'react';
 import { Plus, Sparkles } from 'lucide-react';
 import { Button } from '@/components/ui/button';
@@ -105,7 +106,11 @@ export function NewHireDialog({
   ];
   async function submit(event: FormEvent<HTMLFormElement>) {
     event.preventDefault();
-    const id = `hire_${crypto.randomUUID()}`;
+    // The first hire of a demo takes the contract fixture id (INTEGRATION.md section 5) so Guard
+    // and TAMM fixtures line up; later hires get a unique id.
+    const id = Object.hasOwn(state.hires, DEMO_FIXTURES.hire)
+      ? `hire_${crypto.randomUUID()}`
+      : DEMO_FIXTURES.hire;
     const saved = await action.run(
       {
         type: 'hire.create',
