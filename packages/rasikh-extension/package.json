{
  "name": "@rasikh/extension",
  "version": "0.1.0",
  "description": "Rasikh Guide: a coach-only browser extension that walks a newcomer through websites that have no API.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:content": "vite build -c vite.content.config.ts --watch --mode development",
    "build": "vite build --mode production && vite build -c vite.content.config.ts --mode production",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.backend.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c tests/e2e/playwright.e2e.config.ts",
    "lint": "eslint src backend --ext .ts,.tsx",
    "dev:backend": "tsx watch backend/server.local.ts",
    "start:backend": "tsx backend/server.local.ts",
    "icons": "node scripts/make-icons.mjs",
    "e2e:run": "node scripts/e2e-run.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jose": "^5.9.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@playwright/test": "^1.46.0",
    "@types/chrome": "^0.0.270",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
