{
  "name": "@rasikh/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic and live quality, privacy and scheduling evidence for Rasikh",
  "exports": {
    ".": "./src/index.ts",
    "./trust-schema.json": "./src/trust-schema.json"
  },
  "scripts": {
    "eval": "tsx src/cli.ts",
    "eval:live": "node scripts/with-guard.mjs -- node --import tsx src/cli.ts --mode live --provider vertex --runs 3",
    "eval:guard": "node scripts/with-guard.mjs",
    "eval:injection": "node scripts/with-guard.mjs -- node --import tsx src/injection/cli.ts live",
    "eval:documents": "tsx src/documents/cli.ts",
    "eval:judge": "tsx src/judge/cli.ts",
    "eval:simulation": "tsx src/simulation.ts",
    "eval:trust": "tsx src/trust.ts",
    "eval:all": "node scripts/with-guard.mjs -- node --import tsx src/pipeline.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rasikh/engine": "file:../rasikh-engine",
    "@rasikh/shared": "file:../shared",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
